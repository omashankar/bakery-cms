# =============================================================================
# Bakery CMS — environment
# =============================================================================
# Copy to `.env.local` and fill in. Every variable the code reads is listed
# here; where one is optional, the comment says what happens without it.
#
# Anything marked [PRODUCTION] must be set before the shop takes real money.
# =============================================================================


# ─────────────────────────────────────────────────────────────
# MongoDB Atlas connection string — REQUIRED
# ─────────────────────────────────────────────────────────────
# 1. Create a free cluster at https://cloud.mongodb.com
# 2. Database → Connect → Drivers → copy the connection string
# 3. URL-encode special characters in the password (@ → %40, ! → %21)
#
# [PRODUCTION] Use a SEPARATE database from development, and add the host's
# egress IPs under Atlas → Network Access, or every request fails to connect.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bakery-cms?retryWrites=true&w=majority


# ─────────────────────────────────────────────────────────────
# Token signing secrets — REQUIRED
# ─────────────────────────────────────────────────────────────
# Generate a fresh value for each:  openssl rand -base64 32
#
# Use THREE DIFFERENT values. The signature is what separates an access token
# from a refresh token, and a storefront customer from an admin; pasting one
# value into two slots removes that separation. See lib/server/auth/jwt.test.ts,
# which pins both failure modes.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional, and it should not be. Left unset it FALLS BACK to JWT_ACCESS_SECRET,
# so a storefront customer's token and an admin's access token are signed with
# the same key — only the `type` claim separates them. [PRODUCTION] set this.
JWT_CUSTOMER_SECRET=

# Token lifetimes. Defaults shown; leave unset to accept them.
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
# JWT_CUSTOMER_TTL=30d


# ─────────────────────────────────────────────────────────────
# Razorpay payment gateway — REQUIRED to take payment
# ─────────────────────────────────────────────────────────────
# 1. Create an account at https://dashboard.razorpay.com
# 2. Settings → API Keys → Generate Test Keys
# 3. Restart the dev server after changing these
#
# TEST keys (rzp_test_…) charge no real money. [PRODUCTION] switch to LIVE keys
# (rzp_live_…). Note these env vars OVERRULE the admin panel: while both are
# set, Admin → Payments → Gateway is read-only.
#
# The secret stays server-side. Never expose it to the client.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# The webhook signing secret. Set it here OR in Admin → Payments → Gateway.
#
# Until one of the two is set, POST /api/razorpay/webhook answers 503 to
# everything — deliberately, because an unsigned webhook is an anonymous request
# that creates paid orders. But that route is the ONLY thing that notices money
# taken with no order attached, which is what happens when a customer's tab dies
# mid-payment. [PRODUCTION] this is not optional.
#
# Register the URL in Razorpay → Settings → Webhooks. Live mode is a SEPARATE
# registration with its own secret — re-do it at live-key cutover.
RAZORPAY_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────
# Cloudinary (media library uploads) — optional, but read at build time
# ─────────────────────────────────────────────────────────────
# Create a free account at https://cloudinary.com → Dashboard.
# Either set the single URL, or the three vars below. Without these the media
# library still works (it stores the raw image URL / data-URI instead).
#
# Read at BUILD time as well as run time: next.config.ts resolves the cloud name
# to allow res.cloudinary.com through the image optimiser. Set it before
# `npm run build`, or photos uploaded later render as blank boxes.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ─────────────────────────────────────────────────────────────
# Public site URL — optional
# ─────────────────────────────────────────────────────────────
# The origin used for links in outbound mail (invoices, order confirmations).
# Unset, it falls back to the SEO store's canonicalBaseUrl — which SEEDS to a
# reserved `.example` domain that never resolves, so every "view your invoice"
# link points nowhere. [PRODUCTION] set this, or set the canonical URL under
# Admin → SEO.
# NEXT_PUBLIC_SITE_URL=https://www.your-bakery.com


# ─────────────────────────────────────────────────────────────
# Reverse-proxy trust — optional
# ─────────────────────────────────────────────────────────────
# `x-forwarded-for` is written by the CLIENT unless something upstream
# overwrites it, so it is believed only where the deployment says so. Until this
# is "true", every IP-keyed rate limit and the maintenance-mode IP allow-list
# are inert BY DESIGN, and the audit trail records no IP.
#
# [PRODUCTION] set to "true" ONLY if a reverse proxy you control rewrites the
# header. Setting it with nothing in front makes every IP-keyed limit forgeable.
#
# Related: lib/server/http/rate-limit.ts is a per-process Map. On Vercel or any
# autoscaled host each instance keeps its own counter, so decide the hosting
# model before relying on those limits.
# TRUST_PROXY_HEADERS=false


# ─────────────────────────────────────────────────────────────
# First admin account — used by `npm run seed` only
# ─────────────────────────────────────────────────────────────
# [PRODUCTION] Set BOTH. Unset, scripts/seed-admin.ts creates the owner account
# with a hardcoded default password ("Admin@12345") and only warns on stdout.
# It seeds once and leaves an existing account unchanged, so a password set this
# way has to be changed afterwards from Admin → Profile.
ADMIN_EMAIL=
ADMIN_PASSWORD=


# ─────────────────────────────────────────────────────────────
# Configured elsewhere, not here
# ─────────────────────────────────────────────────────────────
# SMTP (outbound mail) lives in the database, not in env:
#   Admin → Settings → SMTP. [PRODUCTION] point it at a domain the bakery owns
#   and publish SPF/DKIM for it, or confirmations land in spam.
