# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-prod/
# Any other build dir (NEXT_DIST_DIR=.next-<name>). Tailwind scans every file
# git does not ignore, so an unignored build's binary cache leaked a broken
# class into globals.css and the dev server stopped compiling CSS.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries only placeholders and is the only
# record of what the eighteen variables are for. It was caught by the rule
# above, so a clone had no starting point at all.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Razorpay admin-saved keys (server-side secret — never commit)
.razorpay-config.json
.data/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# One-off migration snapshots: whole collections, including customer addresses.
scripts/.snapshots/

# Banner artwork dropped here to be uploaded to the CDN, not to be committed.
banners/
